rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isRsvpBaseValid() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'guestId',
        'guestName',
        'attendanceStatus',
        'guestCount',
        'message',
        'language',
        'deviceId',
        'createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'guestId',
        'guestName',
        'attendanceStatus',
        'guestCount',
        'message',
        'language',
        'deviceId',
        'createdAt',
        'updatedAt',
        'notificationsEnabled',
        'fcmToken',
        'reminderSchedule',
        'notificationsUpdatedAt'
      ])
      && request.resource.data.eventId is string
      && request.resource.data.guestId is string
      && request.resource.data.guestName is string
      && request.resource.data.attendanceStatus in ['attending', 'declined']
      && request.resource.data.guestCount is int
      && request.resource.data.message is string
      && request.resource.data.language is string
      && request.resource.data.deviceId is string
      && request.resource.data.eventId.size() <= 80
      && request.resource.data.guestId.size() <= 120
      && request.resource.data.guestName.size() <= 160
      && request.resource.data.message.size() <= 500
      && request.resource.data.language.size() <= 8
      && request.resource.data.deviceId.size() <= 160
      && (
        (request.resource.data.attendanceStatus == 'attending'
          && request.resource.data.guestCount >= 1
          && request.resource.data.guestCount <= 5)
        ||
        (request.resource.data.attendanceStatus == 'declined'
          && request.resource.data.guestCount == 0)
      );
    }

    // RSVP feature: one collection only.
    // Guests can create/update their deterministic response document.
    // Listing is disabled so visitors cannot browse the guest list.
    match /guestResponses/{responseId} {
      allow list: if false;
      allow get: if false;
      allow create, update: if isRsvpBaseValid();
      allow delete: if false;
    }

    // Existing comments feature from the current site. Keep write-only behavior.
    match /comments/{commentId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'siteId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.siteId is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.message.size() <= 1000
        && request.resource.data.siteId.size() <= 80;
    }
  }
}
